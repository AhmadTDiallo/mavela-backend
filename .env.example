# Set this only in an untracked local .env or deployment secret store.
MAVELA_DB_PASSWORD=<set-a-local-dev-password>
OPENAPI_ENABLED=true

# Separate Cognito/OIDC staff authentication. Keep disabled for normal local
# customer development. When enabled, all values below are required and the
# admin API accepts only Cognito *access* tokens for this app client.
MAVELA_ADMIN_AUTH_ENABLED=false
# MAVELA_ADMIN_AUTH_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# MAVELA_ADMIN_AUTH_CLIENT_ID=<staff-cognito-app-client-id>
MAVELA_ADMIN_AUTH_GROUPS_CLAIM=cognito:groups
# Staff access also requires a pre-provisioned ACTIVE `staff_users` record
# whose external_subject equals the Cognito access token's `sub`. Do not seed
# a default administrator or place an admin token in this file.

# Leave disabled unless a private, S3-compatible evidence store is configured.
MAVELA_KYC_STORAGE_ENABLED=false
MAVELA_KYC_STORAGE_BUCKET=mavela-kyc-local
MAVELA_KYC_STORAGE_REGION=af-south-1
MAVELA_KYC_STORAGE_FORCE_PATH_STYLE=false
MAVELA_KYC_STORAGE_ALLOW_INSECURE_ENDPOINT=false
MAVELA_KYC_STORAGE_UPLOAD_URL_TTL=PT10M
MAVELA_KYC_STORAGE_MAX_IMAGE_SIZE_BYTES=10485760
MAVELA_KYC_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
# MAVELA_KYC_STORAGE_ENDPOINT=https://private-s3-endpoint.example
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY belong only in the deployment
# environment or local shell; do not add them to source control.

# Development-only MinIO profile (`docker compose --profile local-kyc-storage up`).
# Use arbitrary local-only values, never cloud credentials.
MAVELA_MINIO_ROOT_USER=mavela_local_storage
# Set a unique local-only value in your untracked .env.
MAVELA_MINIO_ROOT_PASSWORD=<set-a-local-dev-password>
# To run the backend against that opt-in local profile, set the following in
# your untracked .env or shell (these are local MinIO credentials, not AWS):
# MAVELA_KYC_STORAGE_ENABLED=true
# MAVELA_KYC_STORAGE_ENDPOINT=http://127.0.0.1:9000
# On an Android emulator, presign against the emulator's host alias instead
# of rewriting the signed URL in Flutter.
# MAVELA_KYC_STORAGE_PRESIGN_ENDPOINT=http://10.0.2.2:9000
# MAVELA_KYC_STORAGE_FORCE_PATH_STYLE=true
# MAVELA_KYC_STORAGE_ALLOW_INSECURE_ENDPOINT=true
# MAVELA_KYC_STORAGE_ACCESS_KEY_ID=mavela_local_storage
# MAVELA_KYC_STORAGE_SECRET_ACCESS_KEY=<the matching local MinIO password>
# The supplied local MinIO profile has no KMS; use NONE locally. A
# production HTTPS store must keep the default AES256 (or equivalent) value.
# MAVELA_KYC_STORAGE_SERVER_SIDE_ENCRYPTION=NONE
